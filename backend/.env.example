# Copy to backend/.env (git-ignored, never baked into the image) and fill in.
# docker-compose.yml reads it for api, worker and beat. Reference:
# docs/DEPLOYMENT.md, "Environment variables".
#
# Not listed here because docker-compose.yml sets them itself:
# REDIS_URL, AUTOMAINTAINER_WORKSPACE_DIR, ENVIRONMENT.

# Required
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
GROQ_API_KEY=
# Comma-separated dashboard origins, e.g. http://localhost:8000
ALLOWED_ORIGINS=

# GitHub access: uncomment a GitHub App (preferred) or a token.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_TOKEN=
# Required if webhooks are configured.
# GITHUB_WEBHOOK_SECRET=

# Optional
# MERGE_POLICY=human
# AGENT_WORKER_CHECK=true

# Opt-in features, off by default. Each needs an optional extra in the
# environment that runs the worker: `uv sync --extra <name>` locally, or the
# image's EXTRAS build arg (docker-compose.yml passes none, so the Compose
# image has only `server`). Reference: docs/DEPLOYMENT.md,
# "Agents and models" and "Code retrieval".
#
# ADK Reviewer (extra: adk; also needs ripgrep on PATH). langgraph or adk.
# REVIEWER_BACKEND=langgraph
#
# Code retrieval (extra: rag). Vertex AI embeddings send repository code to
# Google Cloud; read docs/RAG.md, "Data egress", first.
# RAG_INDEXING_ENABLED=false
# RAG_RETRIEVAL_ENABLED=false
# RAG_TOP_K=8
# RAG_EMBEDDING_MODEL=text-embedding-005
# RAG_EMBEDDING_BATCH_SIZE=16
# RAG_MAX_CHUNKS=20000
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
