    "/github/installations/claim": {
      "post": {
        "description": "Link a GitHub App installation to the caller's org.\n\nRequires an org owner/admin, plus the caller's GitHub user token in\n``X-GitHub-User-Token`` (the dashboard sends the Supabase GitHub\nprovider_token). GitHub must confirm the installation is accessible to\nthat user and that its account is the user or an org they administer\n(github_app.verify_installation_claim). An installation already linked to\nanother org is never moved (409).",
        "operationId": "claim_github_installation_github_installations_claim_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-github-user-token",
            "required": false,
