# Copy to terraform.tfvars (git-ignored) and fill in. No secret belongs in
# this file: secret values go into Secret Manager as versions (README.md).

project_id = "automaintainer-prod"
region     = "us-central1"
zone       = "us-central1-a"

# `gcloud billing projects describe automaintainer-prod` prints it.
billing_account_id         = "000000-000000-000000"
budget_amount              = 100
budget_currency            = "USD"
budget_notification_emails = ["owner@example.com"]

# "vm" (default, cheapest) or "memorystore"; see variables.tf.
redis_mode = "vm"
# Redis password from the "redis-url" secret (docs/DEPLOYMENT.md, step 3).
redis_auth_enabled = true

# false for the first apply; true once every mounted secret has a version.
mount_secrets = false

cloud_trace_enabled = false

# Metrics to Cloud Monitoring from the API and the worker (monitoring.tf).
cloud_monitoring_enabled = false
# Turn on after the metrics have been written once (docs/DEPLOYMENT.md,
# "Metrics and alerts").
monitoring_app_alerts_enabled = false
# Who receives the alerts. No default on purpose: put your address in the
# commented line and uncomment it, or keep null for no e-mail channel.
# monitoring_alert_email = "<alerts e-mail address>"
monitoring_alert_email = null

api_max_instances  = 3
worker_concurrency = 2

app_env = {
  SUPABASE_URL         = "https://<project ref>.supabase.co"
  GITHUB_APP_ID        = "<app id>"
  GITHUB_APP_SLUG      = "<app slug>"
  GITHUB_APP_CLIENT_ID = "<client id>"
  ALLOWED_ORIGINS      = "https://<dashboard origin>"
  DASHBOARD_URL        = "https://<dashboard origin>"
  MERGE_POLICY         = "human"
}
