# Secrets: patterns must be recursive. A bare `.env` matches only the context
# root, which silently let backend/.env into the image layer.
**/.env
**/.env.*
!**/.env.example

# Dependencies and virtualenvs (host-built, wrong platform for the image)
**/node_modules
**/venv
**/.venv
**/__pycache__
**/*.pyc

# Build output: the frontend is built inside stage 1, never copied from host
**/.next
**/out
**/.pytest_cache

# SDK build output (`uv build` in backend/ writes dist/): host-built
# distributions are never part of the image, which runs the source tree.
backend/dist
backend/build
**/*.egg-info

# VCS and local noise
.git
.gitignore
**/.DS_Store

# Not needed in the image. .claude can hold whole worktree copies of the repo,
# which would bloat the build context enormously.
.claude
.github
docs
docker-compose.yml
**/*.log
